# ---------- Public address (Caddy gets the HTTPS certificate for this) ----------
DOMAIN=localhost

# ---------- CORS: exact https frontend origins, comma separated ----------
APP_CORS_ALLOWED_ORIGINS=http://localhost:8080

# ---------- JWT ----------
APP_JWT_SECRET=


# ---------- Email (SMTP) ---------
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# APP_MAIL_FROM=
# APP_FRONTEND_BASE_URL=

# ---------- Razorpay (online payments) ----------
# APP_RAZORPAY_KEYID=
# APP_RAZORPAY_KEYSECRET=
# APP_RAZORPAY_WEBHOOKSECRET=

# ---------- Image storage (S3-compatible). Leave APP_MEDIA_BUCKET empty to switch the feature off ----------
APP_MEDIA_BUCKET=
APP_MEDIA_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
APP_MEDIA_REGION=auto
APP_MEDIA_ACCESSKEY=
APP_MEDIA_SECRETKEY=
# Public address browsers load images from (a CDN or custom domain in front of the bucket)
APP_MEDIA_PUBLICBASEURL=https://images.yourdomain.com